<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_timeline_gestures"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Bar with Back & Video Title -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#40000000" 
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_glass_circle"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_left" 
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvVideoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/btnQuickSettingsCorner"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_glass_circle"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_gear" 
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Side Buttons (Lock & Earbud) padded inward from horizontal screen edge -->
    <LinearLayout
        android:id="@+id/layoutSideLeftButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="36dp"
        android:background="@null"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnLockCustom"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_glass_circle"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lock_premium" 
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnHeadphone"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_glass_circle"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_earbud" 
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Top Left Lock Button for Locked Mode -->
    <ImageButton
        android:id="@+id/btnLockTopLeft"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="36dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_glass_circle"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_lock_premium"
        android:visibility="gone"
        app:tint="#FF5252" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_side_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:overScrollMode="never"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="90dp" 
        android:gravity="center"
        android:overScrollMode="never"
        android:visibility="gone" />

</RelativeLayout>
