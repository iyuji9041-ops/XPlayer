<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vaultAuthRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/vaultHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBackVault"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_circle"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_left"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvVaultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Private Vault"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imgLockIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_lock_premium"
        app:tint="#AECBFA" />

    <TextView
        android:id="@+id/tvVaultPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Enter PIN to unlock"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVaultSubPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="32dp"
        android:gravity="center"
        android:text="Your private files are encrypted with AES-256"
        android:textColor="#80FFFFFF"
        android:textSize="13sp" />

    <!-- PIN dots container -->
    <LinearLayout
        android:id="@+id/layoutPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#40FFFFFF" />
        <View
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#40FFFFFF" />
        <View
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#40FFFFFF" />
        <View
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#40FFFFFF" />
    </LinearLayout>

    <!-- Pattern Lock View (hidden by default unless pattern mode) -->
    <com.Shyam.xplayer.vault.PatternLockView
        android:id="@+id/patternLockView"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <!-- Numeric Keypad for PIN -->
    <GridLayout
        android:id="@+id/gridKeypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:columnCount="3"
        android:rowCount="4">

        <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/btnKey1" android:layout_width="80dp" android:layout_height="64dp" android:text="1" android:textColor="#FFFFFF" android:textSize="24sp" />
        <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/btnKey2" android:layout_width="80dp" android:layout_height="64dp" android:text="2" android:textColor="#FFFFFF" android:textSize="24sp" />
        <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/btnKey3" android:layout_width="80dp" android:layout_height="64dp" android:text="3" android:textColor="#FFFFFF" android:textSize="24sp" />

        <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/btnKey4" android:layout_width="80dp" android:layout_height="64dp" android:text="4" android:textColor="#FFFFFF" android:textSize="24sp" />
        <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/btnKey5" android:layout_width="80dp" android:layout_height="64dp" android:text="5" android:textColor="#FFFFFF" android:textSize="24sp" />
        <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/btnKey6" android:layout_width="80dp" android:layout_height="64dp" android:text="6" android:textColor="#FFFFFF" android:textSize="24sp" />

        <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/btnKey7" android:layout_width="80dp" android:layout_height="64dp" android:text="7" android:textColor="#FFFFFF" android:textSize="24sp" />
        <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/btnKey8" android:layout_width="80dp" android:layout_height="64dp" android:text="8" android:textColor="#FFFFFF" android:textSize="24sp" />
        <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/btnKey9" android:layout_width="80dp" android:layout_height="64dp" android:text="9" android:textColor="#FFFFFF" android:textSize="24sp" />

        <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/btnKeyForgot" android:layout_width="80dp" android:layout_height="64dp" android:text="Forgot?" android:textColor="#AECBFA" android:textSize="12sp" />
        <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/btnKey0" android:layout_width="80dp" android:layout_height="64dp" android:text="0" android:textColor="#FFFFFF" android:textSize="24sp" />
        <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/btnKeyDel" android:layout_width="80dp" android:layout_height="64dp" android:text="DEL" android:textColor="#FFFFFF" android:textSize="14sp" />
    </GridLayout>

</LinearLayout>
