<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vaultGalleryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <LinearLayout
        android:id="@+id/vaultGalleryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBackGallery"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_circle"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_left"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Private Vault"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVaultCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 files encrypted"
                android:textColor="#80FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnAddVaultVideo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_circle"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_input_add"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVaultEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:text="No videos in vault.\nTap + to hide and encrypt videos."
        android:textColor="#66FFFFFF"
        android:textSize="16sp"
        android:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVaultVideos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/vaultGalleryHeader"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp" />

    <ProgressBar
        android:id="@+id/vaultProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="#FFFFFF"
        android:visibility="gone" />

</RelativeLayout>
